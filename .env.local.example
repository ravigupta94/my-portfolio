# Ravi Gupta Portfolio — Environment Variables

# MongoDB Atlas connection string
# Get yours at: https://cloud.mongodb.com → Connect → Drivers → copy URI
# Replace <username>, <password>, and <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ravi-portfolio?retryWrites=true&w=majority

# Next.js public URL (used for OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel secret (used in Part 3)
ADMIN_SECRET=change-me-to-a-long-random-string

# OpenAI API Key for Ravi AI Assistant (Part 2)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

